# Application Settings
APP_ENV=development
APP_NAME="AgentShield AI"
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# Security and Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-32-chars-min
# Fernet 32 url-safe base64-encoded key. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyeWVhcm9sZD0=

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for production/docker, SQLite for local testing)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentshield
# For local SQLite: sqlite:///./agentshield.db

# Message Broker and Background Worker (Redis + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider Credentials (Optional default keys, external agent credentials can also be stored per agent)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# CORS & Network
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_AGENT_HOSTS=[]
ALLOW_PRIVATE_IPS_FOR_TESTING=false

# Logging & Monitoring
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

